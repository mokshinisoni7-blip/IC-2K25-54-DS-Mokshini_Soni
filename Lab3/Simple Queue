#include<iostream>
#define max 5
using namespace std;

class s_queue{
    int arr[max],f,r,x;
    public:
    void insert();
    void delete_e();
    void display();
    s_queue(){
        f=r=-1;
        for(int i=0;i<max;i++){
            arr[i]=0;
        }
    }
};

void s_queue::insert(){
    if (r==max-1){
        cout<<"Queue is fulled\n";
    }
    else{
        cout<<"Enter your element:";
        cin>>x;
        if(f==-1){
            f=r=0;
            arr[f]=x;
        }
        else{
            r++;
            arr[r]=x;
            cout<<"Element inserted......\n";
        }
    }
}

void s_queue::delete_e(){
    if(f==-1){
        cout<<"Empty queue\n";
    }
    else{
        if(f==r){
            x=arr[f];
            arr[f]=0;
            cout<<x<<"is deleted....\n";
            f=r=-1;
        }
        else{
            x=arr[f];
            arr[f]=0;
            f+=1;
            cout<<x<<"is deleted.....\n";
        }
    }
}

void s_queue::display(){
    if(f==-1){
        cout<<"Empty Queue\n";
    }
    else{
        for(int i=f;i<=r;i++){
            cout<<arr[i]<<",";
        }
        
    }
    cout<<endl;
}

int main(){
    s_queue sq;
    int t;
    char ch;
    do{
        cout<<"Press 1 for Insertion, 2 for Deletion ,3 for Display";
        cin>>t;
        switch(t){
            case 1:sq.insert();
            break;
            case 2:sq.delete_e();
            break;
            case 3:sq.display();
            break;
        }
        cout<<"Press y or Y to continue:";
        cin>>ch;
        
    }while(ch=='y' || ch=='Y');
}
