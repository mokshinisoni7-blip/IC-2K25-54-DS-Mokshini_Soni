#include<iostream>
using namespace std;

int main(){
    int arr[10],a,temp;
    for(int i=0;i<10;i++){
        cout<<"Enter "<<i+1<<" element: ";
        cin>>a;
        arr[i]=a;
    }
    cout<<"Your array:\n[";
    for(int i=0;i<10;i++){
        cout<<arr[i]<<",";
    }
    cout<<"]\n";
    
    for(int i=1;i<10;i++){
        for(int j=i;j>0;j--){
            if(arr[j-1]>arr[j]){
                temp=arr[j-1];
                arr[j-1]=arr[j];
                arr[j]=temp;
            }   
        }
    }
    cout<<"Sorted array:\n[";
    for(int i=0;i<10;i++){
        cout<<arr[i]<<",";
    }
    cout<<"]\n";
}


