//Selection sorting
#include<iostream>
using namespace std;

int main(){
    int arr[10],a,min,t;
    for(int i=0;i<10;i++){
        cout<<"Enter "<<i+1<<" element: ";
        cin>>a;
        arr[i]=a;
    }
    cout<<"Your array:\n[";
    for(int i=0;i<10;i++){
        cout<<arr[i]<<",";
    }
    cout<<"]\n";
    
    for(int i=0;i<10;i++){
        min=arr[i];
        t=i;
        for(int j=i;j<10;j++){
            if(arr[j]<min){
                min=arr[j];
                t=j;
            }
        }
        if(t!=i){
            arr[t]=arr[i];
            arr[i]=min;
        }
    }
    
    cout<<"Sorted array:\n[";
    for(int i=0;i<10;i++){
        cout<<arr[i]<<",";
    }
    cout<<"]\n";
}

